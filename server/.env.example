# PostgreSQL admin password (Compose database initialization only)
POSTGRES_PASSWORD=

# URL-safe app-role password; generate with secrets.token_hex(32)
POSTGRES_APP_PASSWORD=

# Compose overrides this with the zeus_app connection string.
DATABASE_URL=postgresql://zeus_app:REPLACE_WITH_POSTGRES_APP_PASSWORD@127.0.0.1:5433/zeus
USE_SQLITE_FALLBACK=false

# JWT signing secret
SECRET_KEY=

# YouTube Data API v3
YOUTUBE_API_KEY=

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# OpenAI
OPENAI_API_KEY=
